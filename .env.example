APP_NAME=ai-assistant-api
APP_ENV=development
DEBUG=true
MOCK_LLM=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Structured intent extract (function calling) — use nano, not answer model
# gpt-4.1-nano (default) or gpt-5-nano (cheapest)
OPENAI_EXTRACT_MODEL=gpt-4.1-nano

# Gemini Google Search grounding (review chat cascade)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GROUNDING_ENABLED=true
GEMINI_TIMEOUT_SECONDS=45
# Skip Gemini for this long after a quota error
GEMINI_QUOTA_COOLDOWN_SECONDS=900

# Fallback live search (OpenAI Responses `web_search` tool)
# Must be a model that supports the hosted web_search tool
OPENAI_SEARCH_MODEL=gpt-5.5
# Trusted sources for static-fact grounding.
# Price / promotion / live-status questions ignore this and search the open web
# (answer is flagged reference_only).
WEB_SEARCH_ALLOWED_DOMAINS=tripadvisor.com,tripadvisor.com.vn,traveloka.com,www.traveloka.com

# RAG sufficiency thresholds
RAG_MIN_QUOTES=2
RAG_MIN_SIMILARITY=0.35
# Per-source quote quota (tripadvisor + chudu24 each); request top_k is a total cap
RAG_PER_SOURCE_K=2

# Previous turns replayed verbatim; older ones are folded into a rolling summary
CHAT_HISTORY_LIMIT=8
CHAT_SUMMARY_BATCH=20

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New dashboard keys OR legacy service role:
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Auth: the API verifies the caller's Supabase access token.
# Asymmetric signing keys (default on new projects) need nothing here — the JWKS
# endpoint is derived from SUPABASE_URL. Override only if it differs.
SUPABASE_JWKS_URL=
# Legacy projects that still sign with HS256 need the shared secret instead:
SUPABASE_JWT_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Chat rate limits. Per identity (signed-in or anonymous user) and per IP —
# the IP bucket is what stops fresh anonymous users being minted in a loop.
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_RATE_LIMIT_PER_DAY=200
CHAT_IP_RATE_LIMIT_PER_MINUTE=40
CHAT_IP_RATE_LIMIT_PER_DAY=600

# optional: Google Places ingest
GOOGLE_PLACES_API_KEY=
